{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local setup window: the only origin allowed to call privileged commands without a prompt.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-connect-server",
    "allow-get-server",
    "allow-connect-local-agents",
    "allow-check-update",
    "allow-get-diagnostics",
    "allow-open-update-page"
  ]
}
